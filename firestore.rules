rules_version = '2';

// ВНИМАНИЕ: эти правила нужно задеплоить в Firebase — они не применяются
// автоматически. Установи Firebase CLI (`npm i -g firebase-tools`),
// авторизуйся (`firebase login`) и запусти:
//
//   firebase deploy --only firestore:rules --project smm-boost-905d5
//
// Либо скопируй содержимое этого файла в Firebase Console →
// Firestore Database → Rules и опубликуй.
//
// Текущая цель Этапа 1: полностью закрыть прямые записи с клиента.
// Все записи в orders / users / topups должны идти только через
// серверные API (Vercel Functions). Клиенту оставлено чтение только
// своих собственных данных.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Пользователи ----
    // Читать может только владелец. Запись — только сервер (admin SDK).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Разрешаем аутентифицированному пользователю (Google/Firebase Auth)
      // создать/обновить только свой собственный документ с ограниченным
      // набором полей профиля. Финансовые поля (balance, bonusBalance и т.п.)
      // остаются под контролем сервера.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly(
                         ['uid','displayName','email','photoURL','authType','createdAt']
                       );
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName','email','photoURL','updatedAt']);
      allow delete: if false;
    }

    // ---- Заказы ----
    // Клиент видит только свои заказы. Запись — только сервер.
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Пополнения ----
    match /topups/{topupId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Каталог услуг (публичный кэш, если используется) ----
    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Всё остальное закрыто по умолчанию ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
