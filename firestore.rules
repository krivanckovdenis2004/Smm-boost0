rules_version = '2';

// Правила соответствуют состоянию до Google Auth / Admin SDK.
// Серверный API (api/auth-social-register.js) пишет в /users клиентским
// Firebase SDK без Firebase Auth — поэтому write разрешён неавторизованному
// клиенту, но только для документов правильной формы (обязательные поля
// хэша пароля и userId). Чтение чужих документов запрещено.
//
// Задеплой:
//   firebase deploy --only firestore:rules --project smm-boost-905d5
// либо Firebase Console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isPasswordUserId(userId) {
      return userId.matches('^[0-9a-f]{32}$');
    }

    // ---- Пользователи ----
    match /users/{userId} {
      // API регистрации/входа читает один документ по детерминированному id
      // для проверки существования логина и пароля. Список /users закрыт.
      allow get: if isPasswordUserId(userId);
      allow list: if false;

      // Регистрация: документ должен содержать userId и хэш пароля,
      // userId в документе должен совпадать с id документа.
      allow create: if isPasswordUserId(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.keys().hasAll(
                         ['userId', 'passwordHash', 'passwordSalt', 'username']
                       );

      // Обновление: нельзя менять хэш/соль/логин чужим writer'ом,
      // разрешаем только обновление сессионного токена и служебных полей.
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.passwordHash == resource.data.passwordHash
                    && request.resource.data.passwordSalt == resource.data.passwordSalt
                    && request.resource.data.usernameLower == resource.data.usernameLower;

      allow delete: if false;
    }

    // ---- Заказы ----
    // Серверный API (api/balance-order.js, api/list-orders.js, api/check-status.js)
    // работает клиентским Firebase SDK без Firebase Auth, поэтому правила
    // валидируют форму документа, а не request.auth. Сессия пользователя
    // проверяется в API до записи.
    match /orders/{orderId} {
      // get разрешён по id (track.html и одиночная подписка в orders.js),
      // list нужен серверному list-orders (query where userId==...).
      allow get: if true;
      allow list: if true;
      // create: обязательные поля заказа, publicOrderId и корректный userId
      allow create: if request.resource.data.keys().hasAll(
                         ['userId', 'publicOrderId', 'service', 'amount', 'price', 'status', 'createdAt']
                       );
      // update: нельзя менять владельца и публичный id заказа
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.publicOrderId == resource.data.publicOrderId;
      allow delete: if false;
    }

    // ---- Идемпотентность заказов ----
    // api/balance-order.js кладёт маркер order_requests/{userId}_{requestId}
    // до создания заказа, чтобы повторный клик не создал дубль в JAP.
    match /order_requests/{reqId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['userId', 'status']);
      allow update: if request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // ---- Пополнения ----
    // Webhook ЮKassa/CryptoBot пишет сюда клиентским SDK без Firebase Auth,
    // поэтому create/update разрешены, но только для документа правильной
    // формы (обязательные поля userId/amount/status/paymentId).
    match /topups/{topupId} {
      // get одного документа по id разрешён всем: webhook ЮKassa/CryptoBot
      // выполняет tx.get(topups/{paymentId}) клиентским SDK без Firebase Auth
      // для проверки идемпотентности (повторный webhook). list остаётся закрыт,
      // поэтому перечислить коллекцию нельзя.
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(
                         ['userId', 'amount', 'status', 'paymentId']
                       );
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.paymentId == resource.data.paymentId;
      allow delete: if false;
    }

    // ---- Каталог услуг (публичный кэш) ----
    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Всё остальное закрыто ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
