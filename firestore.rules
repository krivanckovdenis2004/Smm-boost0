rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isHexUserId(userId) {
      return userId.matches('^[0-9a-f]{32}$');
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      allow get: if isHexUserId(userId);
      allow list: if false;

      allow create: if isHexUserId(userId)
        && request.resource.data.userId == userId
        && (
          request.resource.data.keys().hasAll(['userId', 'passwordHash', 'passwordSalt', 'username'])
          || request.resource.data.keys().hasAll(['userId', 'firebaseUid', 'email', 'sessionToken'])
        );

      allow update: if isHexUserId(userId)
        && request.resource.data.userId == resource.data.userId
        && (
          (
            ('passwordHash' in resource.data)
            && request.resource.data.passwordHash == resource.data.passwordHash
            && request.resource.data.passwordSalt == resource.data.passwordSalt
            && request.resource.data.usernameLower == resource.data.usernameLower
          )
          || (
            !('passwordHash' in resource.data)
            && changedOnly([
              'firebaseUid', 'authType', 'authProviders', 'username', 'usernameLower',
              'displayName', 'email', 'photoURL', 'emailVerified', 'pendingEmailVerification',
              'sessionToken', 'updatedAt', 'lastLoginAt'
            ])
            && request.resource.data.balance == resource.data.balance
            && request.resource.data.bonusBalance == resource.data.bonusBalance
            && request.resource.data.referralsCount == resource.data.referralsCount
            && request.resource.data.referralEarned == resource.data.referralEarned
          )
          || (
            changedOnly(['referralsCount', 'updatedAt'])
            && request.resource.data.referralsCount == resource.data.referralsCount + 1
          )
        );

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.keys().hasAll(['userId', 'publicOrderId', 'service', 'amount', 'price', 'status', 'createdAt']);
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.publicOrderId == resource.data.publicOrderId;
      allow delete: if false;
    }

    match /order_requests/{reqId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['userId', 'status']);
      allow update: if request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /topups/{topupId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['userId', 'amount', 'status', 'paymentId']);
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.paymentId == resource.data.paymentId;
      allow delete: if false;
    }

    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /free_claims/{userId} {
      allow get: if isHexUserId(userId);
      allow list: if false;
      allow create: if isHexUserId(userId) && request.resource.data.userId == userId;
      allow update: if isHexUserId(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
