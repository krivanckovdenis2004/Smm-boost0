rules_version = '2';

// Правила соответствуют состоянию до Google Auth / Admin SDK.
// Серверный API (api/auth-social-register.js) пишет в /users клиентским
// Firebase SDK без Firebase Auth — поэтому write разрешён неавторизованному
// клиенту, но только для документов правильной формы (обязательные поля
// хэша пароля и userId). Чтение чужих документов запрещено.
//
// Задеплой:
//   firebase deploy --only firestore:rules --project smm-boost-905d5
// либо Firebase Console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Пользователи ----
    match /users/{userId} {
      // Клиент не читает /users напрямую (данные приходят через /api),
      // но на случай будущего чтения — только владельцу.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Регистрация: документ должен содержать userId и хэш пароля,
      // userId в документе должен совпадать с id документа.
      allow create: if request.resource.data.userId == userId
                    && request.resource.data.keys().hasAll(
                         ['userId', 'passwordHash', 'passwordSalt', 'username']
                       );

      // Обновление: нельзя менять хэш/соль/логин чужим writer'ом,
      // разрешаем только обновление сессионного токена и служебных полей.
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.passwordHash == resource.data.passwordHash
                    && request.resource.data.passwordSalt == resource.data.passwordSalt
                    && request.resource.data.usernameLower == resource.data.usernameLower;

      allow delete: if false;
    }

    // ---- Заказы ----
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Пополнения ----
    match /topups/{topupId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Каталог услуг (публичный кэш) ----
    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Всё остальное закрыто ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
